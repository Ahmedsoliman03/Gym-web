					"response": []
				},
				{
					"name": "Activate Account (Invite Code)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"inviteCode\": \"YA4EY5GN\",\n  \"password\": \"CoachPass123!\",\n  \"confirmPassword\": \"CoachPass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/activate",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"activate"
							]
						},
						"description": "Activate an account using an invite code (used by Coaches). Sets the password for the account."
					},
					"response": []
				},
				{
					"name": "Token Refresh",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"your_refresh_token_here\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"token",
								"refresh"
							]
						},
						"description": "Refresh the access token using a refresh token."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Logout the user by blacklisting the refresh token. Requires an Authorization Bearer header."
					},
					"response": []
				}
			]
		},
