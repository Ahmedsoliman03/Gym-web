    "About": {
        "title": "About GymSpot",
        "overview": "GymSpot is a digital platform that connects gyms, coaches, and clients in one ecosystem designed to simplify hiring, marketing, and communication in the fitness industry.",
        "forGymsTitle": "For Gyms",
        "forGymsDescription": "GymSpot acts as both a recruitment and marketing platform. Gyms can publish job posts for coaching positions, allowing qualified coaches to apply directly. At the same time, gyms can promote their business by showcasing their profiles, including photos, available plans, and location.",
        "forCoachesTitle": "For Coaches",
        "forCoachesDescription": "GymSpot creates career opportunities and personal branding. Coaches can discover job openings and apply directly. In addition, coaches can market themselves by offering online coaching services, highlighting certifications and transformation results.",
